#!/usr/bin/env node
/**
 * amq flocking build-sw — generate dist/sw.js from the built site.
 *
 * No server state at all, so the worker PRECACHES everything `vite build` emitted and
 * serves it cache-first. The cache name hashes the contents, so any deploy that changes
 * a byte ships a new cache and drops the old one. Reads dist/, so it must run AFTER
 * `vite build` — `bun run build` chains it.
 *
 * The site is published under a SUBPATH (amatiasq.github.io/flocking/), so every URL is
 * RELATIVE and resolved at runtime against the worker's own scope; absolute `/asset`
 * URLs would point at the origin root and cache nothing.
 *
 * Plain JS on purpose: an `amq` command is an executable with no extension, so node
 * cannot type-strip it.
 */
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { readdir, readFile, writeFile } from 'node:fs/promises';
import { dirname, join, relative } from 'node:path';
import { fileURLToPath } from 'node:url';

if (['-h', '--help', 'help'].includes(process.argv[2])) {
  const src = readFileSync(fileURLToPath(import.meta.url), 'utf8');
  console.log(src.slice(0, src.indexOf('*/')).split('\n').slice(1).map((l) => l.replace(/^\s*\/?\*+ ?/, '')).join('\n').trim());
  process.exit(0);
}

// amq/ sits at the project root, so `..` is flocking/.
const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const DIST = join(ROOT, 'dist');

const files = (await walk(DIST))
  // sw.js caches everything else, not itself; sourcemaps are dead weight offline.
  .filter((path) => path !== 'sw.js' && !path.endsWith('.map'))
  .sort();

// A navigation asks for the directory, not for `index.html`. Cache both forms:
// the empty string resolves to the scope itself, which is what `/flocking/` is.
const urls = files.flatMap((path) => (path === 'index.html' ? ['', path] : [path]));

// Hash the CONTENTS, not just the list. Vite's output carries its hash in the
// filename, but `index.html` keeps a stable name, so a list-derived cache name
// would not change when only the HTML did — everyone would keep the old copy
// forever, with no way to tell.
const digest = createHash('sha256');

for (const url of urls) {
  digest.update(url);
  // '' is an alias of index.html, already hashed under its real name.
  if (url) digest.update(await readFile(join(DIST, url)));
}

const version = digest.digest('hex').slice(0, 12);

const sw = `/*
 * flocking's service worker — GENERATED by amq/amq-flocking-build-sw, do not edit.
 *
 * Precaches the whole built site so the simulation runs offline once installed. Everything
 * is served cache-first; navigations fall back to the cached shell.
 *
 * Every asset is listed RELATIVE to this worker's scope: the site is published under a
 * subpath and an absolute path would miss.
 */
const CACHE = 'flocking-${version}';
const ASSETS = ${JSON.stringify(urls, null, 2)};

const scoped = (path) => new URL(path, self.registration.scope).href;

// Cache tolerantly: one missing asset must not abort the whole batch.
function cacheAll(cache, urls) {
  return Promise.all(
    urls.map((url) =>
      cache.add(new Request(scoped(url), { cache: 'reload' })).catch(() => {}),
    ),
  );
}

self.addEventListener('install', (event) => {
  event.waitUntil(
    (async () => {
      const cache = await caches.open(CACHE);
      await cacheAll(cache, ASSETS);
      await self.skipWaiting();
    })(),
  );
});

self.addEventListener('activate', (event) => {
  event.waitUntil(
    (async () => {
      const keys = await caches.keys();
      await Promise.all(keys.filter((k) => k !== CACHE).map((k) => caches.delete(k)));
      await self.clients.claim();
    })(),
  );
});

self.addEventListener('fetch', (event) => {
  const { request } = event;
  if (request.method !== 'GET' || new URL(request.url).origin !== self.location.origin)
    return;

  event.respondWith(
    (async () => {
      const cached = await caches.match(request, { ignoreSearch: true });
      if (cached) return cached;

      try {
        const response = await fetch(request);
        if (response.ok) {
          const cache = await caches.open(CACHE);
          cache.put(request, response.clone());
        }
        return response;
      } catch {
        // Offline and uncached: a navigation still gets the shell, so the app boots.
        if (request.mode === 'navigate') {
          const shell = await caches.match(scoped(''));
          if (shell) return shell;
        }
        throw new Error('offline and not cached');
      }
    })(),
  );
});
`;

await writeFile(join(DIST, 'sw.js'), sw);
console.log(
  `Wrote dist/sw.js — precaching ${urls.length} files (cache flocking-${version})`,
);

async function walk(dir) {
  const entries = await readdir(dir, { withFileTypes: true });
  const out = [];

  for (const entry of entries) {
    const full = join(dir, entry.name);
    if (entry.isDirectory()) out.push(...(await walk(full)));
    else out.push(relative(DIST, full));
  }

  return out;
}
